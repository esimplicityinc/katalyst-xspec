{
  "name": "full-stack-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Example project demonstrating full-stack testing with @esimplicity/stack-tests",
  "scripts": {
    "gen": "bddgen",
    "test": "bddgen && playwright test",
    "test:api": "bddgen && playwright test --project=api",
    "test:ui": "bddgen && playwright test --project=ui",
    "test:tui": "bddgen && playwright test --project=tui",
    "test:hybrid": "bddgen && playwright test --project=hybrid",
    "test:headed": "bddgen && playwright test --headed",
    "test:debug": "bddgen && PWDEBUG=1 playwright test"
  },
  "dependencies": {
    "@esimplicity/stack-tests": "^0.3.0",
    "@playwright/test": "^1.49.0",
    "playwright-bdd": "^9.1.0",
    "tui-tester": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
