{
  "name": "@esimplicity/stack-tests",
  "version": "0.3.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./steps": {
      "types": "./dist/steps/index.d.ts",
      "import": "./dist/steps/index.js",
      "default": "./dist/steps/index.js"
    }
  },
  "description": "Reusable Playwright-BDD fixtures, ports, adapters, and step registrations for API/UI/hybrid/TUI testing.",
  "repository": {
    "type": "git",
    "url": "https://github.com/esimplicityinc/katalyst-bdd-test"
  },
  "bugs": {
    "url": "https://github.com/esimplicityinc/katalyst-bdd-test/issues"
  },
  "homepage": "https://github.com/esimplicityinc/katalyst-bdd-test",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Kata",
  "keywords": [
    "playwright",
    "bdd",
    "testing",
    "cucumber",
    "api",
    "ui",
    "hybrid",
    "tui",
    "terminal",
    "cli"
  ],
  "files": [
    "dist",
    "scripts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "peerDependencies": {
    "@playwright/test": "^1.49.0",
    "playwright-bdd": "^9.1.0",
    "tui-tester": "^1.0.0",
    "typescript": "^5.6.0"
  },
  "peerDependenciesMeta": {
    "tui-tester": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.2"
  }
}
