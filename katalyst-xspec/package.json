{
  "name": "@esimplicitylabs/katalyst-xspec",
  "version": "0.7.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./steps": {
      "types": "./dist/steps/index.d.ts",
      "import": "./dist/steps/index.js",
      "default": "./dist/steps/index.js"
    }
  },
  "description": "Playwright-BDD testing framework for API/UI/hybrid/TUI: fixtures, ports, adapters, step definitions, and the katalyst-xspec CLI (init, upgrade, stubs).",
  "repository": {
    "type": "git",
    "url": "https://github.com/esimplicityinc/katalyst-xspec"
  },
  "bugs": {
    "url": "https://github.com/esimplicityinc/katalyst-xspec/issues"
  },
  "homepage": "https://github.com/esimplicityinc/katalyst-xspec",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Kata",
  "keywords": [
    "playwright",
    "bdd",
    "testing",
    "cucumber",
    "api",
    "ui",
    "hybrid",
    "tui",
    "terminal",
    "cli"
  ],
  "files": [
    "dist",
    "bin",
    "cli",
    "skills",
    "scripts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test src/__tests__/*.test.ts && node --test test/*.test.cjs",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "peerDependencies": {
    "@playwright/test": "^1.49.0",
    "playwright-bdd": "^9.1.0",
    "tui-tester": "^0.3.0",
    "typescript": "^5.6.0"
  },
  "peerDependenciesMeta": {
    "tui-tester": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "katalyst-xspec": "bin/katalyst-xspec.cjs"
  }
}
